# Корень сайта = корень репозитория. Игра и API лежат в www/, служебное закрываем.
<FilesMatch "^\.(env|git|deploy)">
  Require all denied
</FilesMatch>
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(server|tests|tools|docs|android|\.git|\.deploy)(/|$) - [F,L]
  # Главная: всегда игра из www/, даже если в корне остался старый index.html
  RewriteRule ^(index\.html)?$ www/index.html [L]
  # Всё, чего нет в корне (api/, fonts/, иконки), берём из www/
  RewriteCond %{REQUEST_URI} !/www/
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)$ www/$1 [L]
</IfModule>
