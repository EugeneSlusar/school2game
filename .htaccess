# Корень сайта = корень репозитория. Игра и API лежат в public_html/, служебное закрываем.
<FilesMatch "^\.(env|git|deploy)">
  Require all denied
</FilesMatch>
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^(server|tests|tools|docs|android|\.git|\.deploy)(/|$) - [F,L]
  # Главная: всегда игра из public_html/, даже если в корне остался старый index.html
  RewriteRule ^(index\.html)?$ public_html/index.html [L]
  # Всё, чего нет в корне (api/, fonts/, иконки), берём из public_html/
  RewriteCond %{REQUEST_URI} !/public_html/
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)$ public_html/$1 [L]
</IfModule>

# Страница игры не кэшируется: после деплоя телефоны сразу получают свежую версию
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
