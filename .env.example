# Скопируй в .env на сервере (в корень проекта) и заполни секреты. .env в git не попадает.
APP_URL=https://lab.orgbox.net/school2game

# MySQL 8.4 на Timeweb
DB_DRIVER=mysql
DB_HOST=localhost
DB_NAME=orgbox_school2game
DB_USER=orgbox_school2game
DB_PASS=

# Бот MAX (платформа MAX для партнёров)
MAX_BOT_TOKEN=
# Ссылка на бота без параметров, например https://max.ru/id1234567890_bot
MAX_BOT_LINK=
# Секрет вебхука: 5–256 символов, только A-Z a-z 0-9 _ -
MAX_WEBHOOK_SECRET=
MAX_API_BASE=https://platform-api2.max.ru

SESSION_DAYS=60
