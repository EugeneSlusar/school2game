# Скопируй в .env на сервере (в корень проекта) и впиши пароль. .env в git не попадает.
APP_URL=https://lab.orgbox.net/school2game

# MySQL 8.4 на Timeweb
DB_DRIVER=mysql
DB_HOST=localhost
DB_NAME=orgbox_school2game
DB_USER=orgbox_school2game
DB_PASS=

# Сколько дней живёт вход на устройстве (дальше можно войти по коду восстановления)
SESSION_DAYS=365
