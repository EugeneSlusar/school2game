{
  "name": "school2game",
  "version": "1.0.0",
  "description": "school2game: учись с игровым вайбом. Соревновательная игра на скорость для 5 класса",
  "scripts": {
    "sync": "cap sync android",
    "build": "node tools/make-index.js docs/artifact-version.html public_html/index.html",
    "test": "node tools/gentest.js",
    "apk": "cap sync android && cd android && ./gradlew assembleDebug",
    "test:api": "php tests/api.test.php",
    "test:ui": "node tests/ui.test.js"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.10",
    "@capacitor/cli": "^7.6.10",
    "@capacitor/core": "^7.6.10",
    "@fontsource/neucha": "^5.3.0",
    "@fontsource/russo-one": "^5.3.0"
  },
  "private": true
}
